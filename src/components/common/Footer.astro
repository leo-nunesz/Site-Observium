---
// Footer institucional do Observium UFRJ
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <!-- Coluna 1: Sobre o Observium e UFRJ -->
    <div class="footer-col">
      <div class="footer-brand">
        <span class="footer-title">OBSERVIUM</span>
        <span class="footer-subtitle">Observatório de Vigilância e Uso de Medicamentos</span>
      </div>
      <p class="footer-desc">
        Estrutura de ensino, pesquisa e extensão da Faculdade de Farmácia da Universidade Federal do Rio de Janeiro (UFRJ), dedicada à promoção do uso seguro e racional de medicamentos e ao fortalecimento do SUS.
      </p>
      <div class="footer-social">
        <a href="https://instagram.com/observium.ufrj" target="_blank" rel="noopener noreferrer" aria-label="Instagram do Observium" class="social-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://www.facebook.com/ObservatorioMedicamentos" target="_blank" rel="noopener noreferrer" aria-label="Facebook do Observium" class="social-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="http://twitter.com/observiumufrj" target="_blank" rel="noopener noreferrer" aria-label="Twitter do Observium" class="social-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a href="https://www.youtube.com/channel/UCOXqRZj_GVZjaTzIXabVnLQ" target="_blank" rel="noopener noreferrer" aria-label="YouTube do Observium" class="social-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
      </div>
    </div>

    <!-- Coluna 2: Navegação e Conteúdos -->
    <div class="footer-col">
      <h4 class="footer-heading">Navegação</h4>
      <ul class="footer-links">
        <li><a href="/observium/quem-somos">Quem Somos</a></li>
        <li><a href="/observium/equipe">Equipe de Pesquisadores</a></li>
        <li><a href="/observium/linhas-de-pesquisa">Linhas de Pesquisa</a></li>
        <li><a href="/conteudo/boletim">Boletim Observium</a></li>
        <li><a href="/conteudo/alertas">Alertas Terapêuticos</a></li>
        <li><a href="/publicacoes/artigos-cientificos">Artigos Científicos</a></li>
        <li><a href="/publicacoes/producao-tecnica">Produção Técnica</a></li>
      </ul>
    </div>

    <!-- Coluna 3: Links Institucionais e Sanitários -->
    <div class="footer-col">
      <h4 class="footer-heading">Links Sanitários</h4>
      <ul class="footer-links">
        <li><a href="http://portal.anvisa.gov.br/" target="_blank" rel="noopener noreferrer">ANVISA</a></li>
        <li><a href="http://portal.anvisa.gov.br/farmacovigilancia" target="_blank" rel="noopener noreferrer">Farmacovigilância ANVISA</a></li>
        <li><a href="http://www.ismp-brasil.org/site/" target="_blank" rel="noopener noreferrer">ISMP Brasil</a></li>
        <li><a href="http://proqualis.net/" target="_blank" rel="noopener noreferrer">Proqualis (Fiocruz)</a></li>
        <li><a href="http://www.who-umc.org/" target="_blank" rel="noopener noreferrer">Uppsala Monitoring Centre (WHO)</a></li>
        <li><a href="https://rbfhss.org.br/sbrafh" target="_blank" rel="noopener noreferrer">SBRAFH / RBFHSS</a></li>
      </ul>
    </div>

    <!-- Coluna 4: Contato e Endereço Oficial -->
    <div class="footer-col">
      <h4 class="footer-heading">Contato Institucional</h4>
      <address class="footer-address">
        <p><strong>Faculdade de Farmácia - UFRJ</strong></p>
        <p>Centro de Ciências da Saúde (CCS)</p>
        <p>Av. Carlos Chagas Filho, nº 373</p>
        <p>Cidade Universitária, Rio de Janeiro - RJ</p>
        <p class="contact-info">
          <span>Tel: (21) 2280-1784 (Ramal: 243)</span>
          <br />
          <span>E-mail: <a href="mailto:observium.ufrj@gmail.com">observium.ufrj@gmail.com</a></span>
        </p>
      </address>
    </div>
  </div>

  <!-- Barra Inferior de Direitos -->
  <div class="footer-bottom">
    <div class="container footer-bottom-content">
      <p>&copy; {currentYear} Observium UFRJ. Todos os direitos reservados. Conteúdo sob licença aberta com fins educacionais e de saúde pública.</p>
      <p class="ufrj-credit">Universidade Federal do Rio de Janeiro</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: #e2e8f0;
    margin-top: auto;
    border-top: 4px solid var(--color-primary);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--space-8);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-3);
  }

  .footer-title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #ffffff;
  }

  .footer-subtitle {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .footer-desc {
    font-size: 0.875rem;
    color: #cbd5e1;
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .footer-social {
    display: flex;
    gap: var(--space-3);
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff !important;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .social-btn:hover {
    background-color: var(--color-primary-light);
    transform: translateY(-2px);
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: var(--space-4);
    position: relative;
    padding-bottom: var(--space-2);
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background-color: var(--color-primary-light);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: #cbd5e1;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease, padding-left 0.15s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #ffffff;
    padding-left: 4px;
    text-decoration: none;
  }

  .footer-address {
    font-style: normal;
    font-size: 0.875rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .footer-address p {
    color: #cbd5e1;
    margin-bottom: 0.25rem;
  }

  .contact-info {
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contact-info a {
    color: #93c5fd;
  }

  .footer-bottom {
    background-color: #001428;
    padding: var(--space-4) 0;
    font-size: 0.8rem;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-bottom-content p {
    color: #94a3b8;
    margin-bottom: 0;
  }

  @media (max-width: 992px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-content {
      grid-template-columns: 1fr;
    }
  }
</style>

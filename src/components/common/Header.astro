---
// Header institucional do Observium UFRJ
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Início', href: '/' },
  {
    label: 'O Observium',
    children: [
      { label: 'Quem Somos', href: '/observium/quem-somos' },
      { label: 'Equipe', href: '/observium/equipe' },
      { label: 'Linhas de Pesquisa', href: '/observium/linhas-de-pesquisa' },
    ],
  },
  {
    label: 'Conteúdo',
    children: [
      { label: 'Boletim Observium', href: '/conteudo/boletim' },
      { label: 'Alertas Terapêuticos', href: '/conteudo/alertas' },
      { label: 'Recomendações Bibliográficas', href: '/conteudo/recomendacoes' },
    ],
  },
  {
    label: 'Publicações',
    children: [
      { label: 'Artigos Científicos', href: '/publicacoes/artigos-cientificos' },
      { label: 'Produção Técnica', href: '/publicacoes/producao-tecnica' },
    ],
  },
  { label: 'Entrevistas e Eventos', href: '/midia-e-eventos/entrevistas' },
  { label: 'Contato', href: '/contato' },
  { label: 'Pesquisa', href: '/pesquisa' },
];
---

<header class="site-header">
  <!-- Barra superior institucional -->
  <div class="top-bar">
    <div class="container top-bar-content">
      <span class="inst-tag">Universidade Federal do Rio de Janeiro • Faculdade de Farmácia</span>
      <div class="top-links">
        <a href="https://ufrj.br" target="_blank" rel="noopener noreferrer">Portal UFRJ</a>
        <span class="sep">|</span>
        <a href="https://farmacia.ufrj.br" target="_blank" rel="noopener noreferrer">Faculdade de Farmácia</a>
      </div>
    </div>
  </div>

  <!-- Barra de navegação principal -->
  <div class="main-header">
    <div class="container main-header-content">
      <!-- Marca Observium e Brasão UFRJ -->
      <div class="brand-group">
        <a href="/" class="brand-link" aria-label="Observium UFRJ - Página Inicial">
          <img src="/images/observium-logo-quadrado.jpg" alt="Logo do Observium" class="logo-observium" width="48" height="48" />
          <div class="brand-text">
            <span class="brand-title">OBSERVIUM</span>
            <span class="brand-subtitle">Observatório de Vigilância e Uso de Medicamentos</span>
          </div>
        </a>
      </div>

      <!-- Navegação Desktop -->
      <nav class="nav-desktop" aria-label="Navegação principal">
        <ul class="nav-list">
          {navItems.map((item) => (
            <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
              {item.children ? (
                <button type="button" class="nav-link dropdown-toggle" aria-expanded="false">
                  {item.label}
                  <svg class="dropdown-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <ul class="dropdown-menu">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="dropdown-link">{child.label}</a>
                    </li>
                  ))}
                </ul>
              ) : (
                <a href={item.href} class={`nav-link ${currentPath === item.href ? 'active' : ''}`}>
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Botão Menu Mobile -->
      <button type="button" class="mobile-toggle" aria-label="Abrir menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Navegação Mobile (Gaveta) -->
  <nav class="nav-mobile" aria-label="Menu móvel" hidden>
    <div class="container mobile-nav-content">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li class="mobile-nav-item">
            {item.children ? (
              <details class="mobile-details">
                <summary class="mobile-summary">{item.label}</summary>
                <ul class="mobile-sublist">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="mobile-sublink">{child.label}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} class="mobile-link">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
  }

  .top-bar {
    background-color: var(--color-primary-dark);
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.35rem 0;
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-links a {
    color: #e2e8f0;
    text-decoration: none;
    font-weight: 500;
  }

  .top-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .sep {
    margin: 0 0.5rem;
    color: #64748b;
  }

  .main-header {
    padding: 0.75rem 0;
  }

  .main-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none !important;
  }

  .logo-observium {
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .brand-subtitle {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: -0.01em;
  }

  /* Nav Desktop */
  .nav-desktop {
    display: block;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    text-decoration: none !important;
    border-radius: var(--radius-md);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    min-width: 220px;
    padding: 0.5rem 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s ease;
    z-index: 200;
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.6rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none !important;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-primary-dark);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Mobile Menu Drawer */
  .nav-mobile {
    display: none;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border-light);
    padding: 1rem 0;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-link,
  .mobile-summary {
    display: block;
    padding: 0.6rem 0;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-primary-dark);
    text-decoration: none;
    cursor: pointer;
  }

  .mobile-sublist {
    list-style: none;
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mobile-sublink {
    display: block;
    padding: 0.4rem 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  @media (max-width: 992px) {
    .nav-desktop {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-mobile:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  // Script simples para abrir/fechar o menu mobile
  const toggleBtn = document.querySelector('.mobile-toggle');
  const mobileNav = document.querySelector('.nav-mobile');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        mobileNav.setAttribute('hidden', '');
      } else {
        mobileNav.removeAttribute('hidden');
      }
    });
  }
</script>

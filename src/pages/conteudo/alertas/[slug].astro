---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatarData } from '../../../utils/date';

export async function getStaticPaths() {
  const alertas = await getCollection('alertas');
  return alertas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.titulo} | Alertas Terapêuticos | Observium UFRJ`}
  description={entry.data.resumo}
>
  <article class="article-container">
    <header class="article-header">
      <div class="container header-inner">
        <a href="/conteudo/alertas" class="back-link">&larr; Voltar para todos os alertas</a>
        <div class="meta-row">
          <span class="badge badge-alert">{entry.data.autoridade_regulatoria}</span>
          <span class="badge">{entry.data.pais}</span>
          <span class="badge">Ano {entry.data.ano}</span>
          <span class="article-date">Publicado em {formatarData(entry.data.data_publicacao)}</span>
        </div>
        <h1 class="article-title">{entry.data.titulo}</h1>
        <div class="medicamento-box">
          <strong>Medicamento(s) em Monitoramento:</strong> {entry.data.medicamento}
        </div>
      </div>
    </header>

    <div class="container article-body-container">
      <div class="article-content prose">
        {entry.data.aviso_disclaimer && (
          <div class="disclaimer-alert">
            <strong>Aviso de Segurança Farmacoterapêutica:</strong> Este alerta baseia-se em decisões e notas oficiais da autoridade sanitária indicada. Pacientes em uso do medicamento não devem interromper o tratamento por conta própria; qualquer dúvida deve ser sanada junto ao médico prescritor ou farmacêutico.
          </div>
        )}

        <h2>Resumo da Comunicação Regulatória</h2>
        <p class="summary-lead">{entry.data.resumo}</p>

        <Content />

        {entry.data.referencias && (
          <div class="references-box">
            <h3>Referências e Fontes Oficiais</h3>
            <p>{entry.data.referencias}</p>
          </div>
        )}
      </div>

      <aside class="article-sidebar">
        <div class="sidebar-box">
          <h3 class="sidebar-title">Ficha Técnica do Alerta</h3>
          <dl class="meta-dl">
            <dt>Autoridade:</dt>
            <dd>{entry.data.autoridade_regulatoria}</dd>
            <dt>País de Origem:</dt>
            <dd>{entry.data.pais}</dd>
            <dt>Data Oficial:</dt>
            <dd>{formatarData(entry.data.data_publicacao)}</dd>
            {entry.data.data_atualizacao && (
              <>
                <dt>Atualização:</dt>
                <dd>{formatarData(entry.data.data_atualizacao)}</dd>
              </>
            )}
          </dl>
          {entry.data.fonte_oficial && (
            <a href={entry.data.fonte_oficial} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm full-width mt-4">
              Acessar Fonte Oficial &nearr;
            </a>
          )}
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #ffffff;
    padding: var(--space-12) 0;
    margin-bottom: var(--space-12);
  }

  .header-inner {
    max-width: 900px;
  }

  .back-link {
    display: inline-block;
    color: #cbd5e1;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .article-date {
    font-size: 0.85rem;
    color: #cbd5e1;
  }

  .article-title {
    color: #ffffff;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.3;
    margin-bottom: var(--space-4);
  }

  .medicamento-box {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    font-size: 1rem;
    color: #e2e8f0;
  }

  .article-body-container {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .disclaimer-alert {
    background-color: var(--color-warning-bg);
    border-left: 4px solid var(--color-danger);
    color: var(--color-warning-text);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .summary-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text);
    background-color: var(--color-surface);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }

  .article-content {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .article-content :global(h2) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-size: 1.35rem;
    color: var(--color-primary-dark);
  }

  .article-content :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    font-size: 1.15rem;
  }

  .article-content :global(ul) {
    margin-left: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .article-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .references-box {
    margin-top: var(--space-8);
    padding: var(--space-5);
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
  }

  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .sidebar-title {
    font-size: 1rem;
    margin-bottom: var(--space-4);
    color: var(--color-primary-dark);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-primary-soft);
  }

  .meta-dl {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-2) var(--space-3);
    font-size: 0.875rem;
  }

  .meta-dl dt {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .meta-dl dd {
    color: var(--color-text-secondary);
  }

  .full-width {
    width: 100%;
  }

  @media (max-width: 850px) {
    .article-body-container {
      grid-template-columns: 1fr;
    }
  }
</style>
